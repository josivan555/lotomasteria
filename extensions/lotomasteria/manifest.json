{
  "manifest_version": 3,
  "name": "LotoMasteria — Importador de Jogos",
  "version": "0.1.0",
  "description": "Importa TXT e JSON do LotoMasteria e preenche os volantes no portal oficial da Caixa. Não efetua pagamentos.",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.loteriasonline.caixa.gov.br/*"],
  "action": { "default_title": "Abrir importador LotoMasteria" },
  "background": { "service_worker": "background.js" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
